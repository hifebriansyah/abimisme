# Local Apache only (GitHub Pages ignores this file, and it is not copied into build/client/).
# Serves the built site from build/client/ at http://localhost/for-fun/abimisme/ (build it with `npm run build:local`).
# Needs mod_rewrite and `AllowOverride FileInfo` (or All) for this folder, like ../chat-learning/.htaccess.
# Always check with the server for a fresh copy while developing (a 304 answer is cheap).
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /for-fun/abimisme/
  # / -> the built home page
  RewriteRule ^$ build/client/index.html [L]
  # a file of the build: bundles in static/, assets/, storybook/, sitemap.xml, ...
  RewriteCond %{DOCUMENT_ROOT}/for-fun/abimisme/build/client/$1 -f
  RewriteRule ^(.+)$ build/client/$1 [L]
  # /kisah -> /kisah/ (the pre-rendered pages are <path>/index.html)
  RewriteCond %{DOCUMENT_ROOT}/for-fun/abimisme/build/client/$1/index.html -f
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]
  # /kisah/ -> build/client/kisah/index.html
  RewriteCond %{DOCUMENT_ROOT}/for-fun/abimisme/build/client/$1index.html -f
  RewriteRule ^(.+/)$ build/client/$1index.html [L]
  # the app's own addresses that are not pre-rendered (one bait, /acak, a wrong address): the app opens and routes it itself,
  # like 404.html does on GitHub Pages
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(kitab|bait|kisah|kata-bapak|tebak|acak)(/.*)?$ build/client/404.html [L]
</IfModule>
