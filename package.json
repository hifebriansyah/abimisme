{
  "name": "abimisme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "rm -rf build && react-router build && node scripts/postbuild.ts",
    "build:local": "BASE_PATH=/for-fun/abimisme/ npm run build && npm run build-storybook",
    "preview": "vite preview --outDir build/client",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o build/client/storybook"
  },
  "dependencies": {
    "@react-router/node": "7.18.5",
    "isbot": "5.1.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@react-router/dev": "7.18.5",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  }
}
